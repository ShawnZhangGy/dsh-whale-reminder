{
  "name": "dsh-whale-reminder",
  "version": "0.1.0",
  "description": "会话结束后提醒你：窗口内常驻浮层 + 声音 + 任务栏/托盘闪烁，QQ 微信式未读体验。",
  "license": "MIT",
  "author": "shawn",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/attention.mjs",
    "lib/dots.mjs",
    "lib/koffi-loader.mjs",
    "lib/schemastery-loader.mjs",
    "lib/selftest-route.mjs",
    "lib/tray.mjs",
    "lib/win32.mjs",
    "assets/badge-1.ico",
    "assets/badge-2.ico",
    "assets/badge-3.ico",
    "assets/badge-4.ico",
    "assets/badge-5.ico",
    "assets/badge-6.ico",
    "assets/badge-7.ico",
    "assets/badge-8.ico",
    "assets/badge-9.ico",
    "assets/badge-9plus.ico",
    "locale/en.json",
    "locale/zh.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnZhangGy/dsh-whale-reminder.git"
  },
  "homepage": "https://github.com/ShawnZhangGy/dsh-whale-reminder#readme",
  "bugs": {
    "url": "https://github.com/ShawnZhangGy/dsh-whale-reminder/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "koffi": "^3.1.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "windows",
    "tray",
    "taskbar",
    "notification",
    "unread"
  ]
}
